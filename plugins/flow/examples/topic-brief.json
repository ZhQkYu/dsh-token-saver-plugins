        "maxIterations": 3,
        "variables": [
          {
            "name": "draft",
            "schema": {
              "type": "string"
            },
            "initial": {
              "kind": "ref",
              "node": "pack",
              "source": "output",
              "path": [
                "text"
              ]
            }
          }
        ],
        "outputs": []
      }
    },
    {
      "id": "long",
      "title": "够长了？",
      "position": {
        "x": 40,
        "y": 80
      },
      "parentId": "polish",
      "type": "condition",
      "data": {
        "branches": [
          {
            "id": "enough",
            "label": ">1500字",
            "logic": "and",
            "conditions": [
              {
                "left": {
                  "kind": "ref",
                  "node": "polish",
                  "source": "inner",
                  "path": [
                    "draft"
                  ]
                },
                "op": "len_gt",
                "right": {
                  "kind": "literal",
                  "value": 1500
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "stop",
      "title": "停止",
      "position": {
