          {
            "variable": "draft",
            "value": {
              "kind": "ref",
              "node": "refine",
              "source": "output",
              "path": [
                "text"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "stats",
      "title": "统计",
      "position": {
        "x": 2560,
        "y": 200
      },
      "type": "code",
      "data": {
        "language": "typescript",
        "inputs": [
          {
            "name": "answers",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "value": {
              "kind": "ref",
              "node": "batch",
              "source": "output",
              "path": [
                "answers"
