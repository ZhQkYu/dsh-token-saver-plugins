          {
            "name": "items",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": [
                  {
                    "name": "full_name",
                    "schema": {
                      "type": "string"
                    }
                  },
                  {
                    "name": "html_url",
                    "schema": {
                      "type": "string"
                    }
                  },
                  {
                    "name": "stargazers_count",
                    "schema": {
                      "type": "integer"
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "id": "skip",
