      "title": "说明",
      "position": {
        "x": 0,
        "y": 0
      },
      "type": "comment",
      "data": {
        "text": "示例：用到 start/intent/http/message/aggregate/llm/batch/json/loop/condition/break/assign/code/tool/agent/question/end/comment。"
      }
    },
    {
