            "value": {
              "kind": "ref",
              "node": "start",
              "source": "output",
              "path": [
                "topic"
              ]
            }
          }
        ],
        "method": "GET",
        "url": "https://api.github.com/search/repositories",
        "headers": [
          {
            "name": "User-Agent",
            "value": "dsh-flow"
          }
        ],
        "query": [
          {
            "name": "q",
            "value": "{{topic}}"
          },
          {
            "name": "per_page",
            "value": "3"
          }
        ],
        "body": {
          "kind": "none"
        },
        "timeoutMs": 15000,
        "outputs": [
          {
            "name": "total_count",
            "schema": {
              "type": "integer"
            }
