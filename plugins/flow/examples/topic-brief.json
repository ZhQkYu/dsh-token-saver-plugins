      "position": {
        "x": 520,
        "y": 300
      },
      "type": "message",
      "data": {
        "inputs": [
          {
            "name": "topic",
            "schema": {
              "type": "string"
            },
            "value": {
              "kind": "ref",
              "node": "start",
              "source": "output",
              "path": [
                "topic"
              ]
            }
          }
        ],
        "template": "「{{topic}}」不是技术主题，跳过 GitHub 搜索。"
      }
    },
    {
      "id": "merge",
      "title": "合并参考",
      "position": {
        "x": 780,
        "y": 200
      },
      "type": "aggregate",
      "data": {
        "groups": [
          {
            "name": "reference",
            "schema": {
              "type": "string"
            },
            "candidates": [
              {
                "kind": "ref",
                "node": "gh",
                "source": "output",
                "path": [
                  "json",
                  "items",
                  "0",
                  "full_name"
                ]
              },
              {
                "kind": "ref",
                "node": "skip",
                "source": "output",
                "path": [
                  "text"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "plan",
      "title": "拆解问题",
      "position": {
        "x": 1040,
        "y": 200
      },
      "type": "llm",
      "data": {
        "inputs": [
          {
            "name": "topic",
            "schema": {
              "type": "string"
            },
            "value": {
              "kind": "ref",
              "node": "start",
              "source": "output",
              "path": [
                "topic"
              ]
            }
          },
          {
            "name": "reference",
            "schema": {
              "type": "string"
            },
            "value": {
              "kind": "ref",
              "node": "merge",
              "source": "output",
              "path": [
                "reference"
              ]
            }
          }
        ],
        "system": "你是调研助理，只输出 JSON。",
        "prompt": "围绕主题「{{topic}}」（参考：{{reference}}）提出 3 个关键问题，每个问题附 1 个关键词。",
        "output": {
          "format": "json",
          "fields": [
            {
              "name": "questions",
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": [
                    {
                      "name": "q",
                      "schema": {
                        "type": "string"
                      },
                      "required": true
                    },
                    {
                      "name": "keyword",
                      "schema": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "required": true
            }
          ]
        }
      }
    },
    {
      "id": "batch",
      "title": "并行回答",
      "position": {
        "x": 1300,
        "y": 120
      },
      "size": {
        "width": 320,
        "height": 200
      },
      "type": "batch",
      "data": {
        "array": {
          "kind": "ref",
          "node": "plan",
          "source": "output",
          "path": [
            "questions"
          ]
        },
        "concurrency": 3,
        "maxItems": 5,
        "outputs": [
          {
            "name": "answers",
            "value": {
              "kind": "ref",
              "node": "answer",
              "source": "output",
              "path": [
                "text"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "answer",
      "title": "回答单个问题",
      "position": {
        "x": 60,
        "y": 70
      },
      "parentId": "batch",
      "type": "llm",
      "data": {
        "inputs": [
          {
            "name": "q",
            "schema": {
              "type": "string"
            },
            "value": {
              "kind": "ref",
              "node": "batch",
              "source": "inner",
              "path": [
                "item",
                "q"
              ]
            }
          },
          {
            "name": "i",
            "schema": {
              "type": "integer"
            },
            "value": {
              "kind": "ref",
              "node": "batch",
              "source": "inner",
              "path": [
                "index"
              ]
            }
          }
        ],
        "system": "",
        "prompt": "第 {{i}} 题：{{q}}\n用 2 句话简要回答。",
        "output": {
          "format": "text"
        }
      }
    },
    {
      "id": "pack",
      "title": "答案转文本",
      "position": {
        "x": 1680,
        "y": 200
      },
      "type": "json",
      "data": {
        "op": "stringify",
        "input": {
          "kind": "ref",
          "node": "batch",
          "source": "output",
          "path": [
            "answers"
          ]
        },
        "pretty": true
      }
    },
    {
      "id": "polish",
      "title": "润色循环",
      "position": {
        "x": 1940,
        "y": 100
      },
      "size": {
        "width": 560,
        "height": 240
      },
      "type": "loop",
      "data": {
        "mode": "count",
